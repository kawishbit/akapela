# Copy to .env and edit. Read by docker compose.

# Host port the app is published on.
AKAPELA_PORT=3000

# Where data lives. Leave unset for the named docker volume `akapela-data`,
# or set a host directory (relative to this file or absolute) to bind-mount it.
# AKAPELA_DATA=./akapela-data

# Optional Genius API token, for looking Lyrics up on Genius as well as LRCLIB.
# Create a client at https://genius.com/api-clients and copy its access token.
# Leave unset and Genius is simply not offered.
# AKAPELA_GENIUS_TOKEN=
